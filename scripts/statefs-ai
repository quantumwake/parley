#!/bin/sh
# Wrapper Claude Code hooks call. Finds or produces the statefs-ai binary:
#   1. a cached build under CLAUDE_PLUGIN_DATA (or ~/.statefs-ai) at this version,
#   2. else build from the vendored source when Go is installed,
#   3. else download the release asset for this platform with gh.
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.statefs-ai}"
BIN="$DATA/bin/statefs-ai"
VER="$(cat "$ROOT/cmd/statefs-ai/VERSION" | tr -d '[:space:]')"
link_user_bin() { mkdir -p "$HOME/.statefs-ai/bin" && ln -sf "$BIN" "$HOME/.statefs-ai/bin/statefs-ai" 2>/dev/null || true; }
if [ -x "$BIN" ] && [ "$("$BIN" version 2>/dev/null)" = "statefs-ai $VER" ]; then
  link_user_bin
  exec "$BIN" "$@"
fi
mkdir -p "$DATA/bin"
if command -v go >/dev/null 2>&1; then
  (cd "$ROOT" && GOFLAGS=-mod=vendor go build -o "$BIN" ./cmd/statefs-ai) && link_user_bin && exec "$BIN" "$@"
fi
if command -v gh >/dev/null 2>&1; then
  OS="$(uname -s | tr '[:upper:]' '[:lower:]')"; ARCH="$(uname -m)"
  case "$ARCH" in x86_64) ARCH=amd64 ;; aarch64) ARCH=arm64 ;; esac
  gh release download "v$VER" -R quantumwake/statefs.ai -p "statefs-ai_${OS}_${ARCH}" -O "$BIN" --clobber && chmod +x "$BIN" && link_user_bin && exec "$BIN" "$@"
fi
echo "statefs-ai: no binary; install Go (https://go.dev) or gh (https://cli.github.com) and retry" >&2
exit 4
