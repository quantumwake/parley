#!/bin/sh
# Wrapper Claude Code hooks call. Finds or produces the parley binary:
#   1. a cached build under CLAUDE_PLUGIN_DATA (or ~/.statefs-ai) at this version,
#   2. else build from the vendored source when Go is installed,
#   3. else download the release asset for this platform with gh.
set -e
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="${CLAUDE_PLUGIN_DATA:-$HOME/.statefs-ai}"
BIN="$DATA/bin/parley"
HOME_BIN="$HOME/.statefs-ai/bin/parley"
PLUGIN_BIN=""
if [ -n "${CLAUDE_PLUGIN_DATA:-}" ]; then
  PLUGIN_BIN="$CLAUDE_PLUGIN_DATA/bin/parley"
fi
VER="$(cat "$ROOT/cmd/parley/VERSION" | tr -d '[:space:]')"
# Without CLAUDE_PLUGIN_DATA (the MCP server starts that way) BIN is already the
# link path; ln -sf onto itself would leave a link to itself and break every
# session that resolves it, so leave it as it is.
link_user_bin() {
  dest="$HOME/.statefs-ai/bin/parley"
  if [ "$BIN" = "$dest" ]; then return 0; fi
  mkdir -p "$HOME/.statefs-ai/bin"
  # A curl install leaves a real binary here. Do not replace a same-or-newer
  # file with a symlink to the plugin cache (which can lag the release).
  if [ -x "$dest" ] && [ ! -L "$dest" ]; then
    HAVE="$("$dest" version 2>/dev/null | head -1 | awk '{print $2}')"
    if [ -n "$HAVE" ] && [ "$(printf '%s\n%s\n' "$VER" "$HAVE" | sort -V | tail -1)" = "$HAVE" ]; then
      return 0
    fi
  fi
  ln -sf "$BIN" "$dest" 2>/dev/null || true
}
# A binary is usable when it runs and is this version or newer. A session
# keeps the plugin root it started with, so an older session's hooks must
# never rebuild a downgrade over a newer install.
version_ok() {
  cand="$1"
  [ -n "$cand" ] && [ -x "$cand" ] && [ ! -d "$cand" ] || return 1
  case "$cand" in
    "$0"|*/scripts/parley) return 1 ;;
  esac
  HAVE="$("$cand" version 2>/dev/null | head -1 | awk '{print $2}')"
  [ -n "$HAVE" ] && [ "$(printf '%s\n%s\n' "$VER" "$HAVE" | sort -V | tail -1)" = "$HAVE" ]
}
# Claude sets CLAUDE_PLUGIN_DATA. If that directory has no binary yet, the
# install in ~/.statefs-ai/bin or a parley on PATH is enough. Build or
# download only after all three fail.
if version_ok "$PLUGIN_BIN"; then
  BIN="$PLUGIN_BIN"
  link_user_bin
  exec "$PLUGIN_BIN" "$@"
fi
if version_ok "$HOME_BIN"; then
  exec "$HOME_BIN" "$@"
fi
if command -v parley >/dev/null 2>&1; then
  found="$(command -v parley)"
  if version_ok "$found"; then
    exec "$found" "$@"
  fi
fi
mkdir -p "$DATA/bin"
if command -v go >/dev/null 2>&1; then
  (cd "$ROOT" && GOFLAGS=-mod=vendor go build -o "$BIN" ./cmd/parley) && link_user_bin && exec "$BIN" "$@"
fi
if command -v gh >/dev/null 2>&1; then
  OS="$(uname -s | tr '[:upper:]' '[:lower:]')"; ARCH="$(uname -m)"
  case "$ARCH" in x86_64) ARCH=amd64 ;; aarch64) ARCH=arm64 ;; esac
  gh release download "v$VER" -R quantumwake/parley -p "parley_${OS}_${ARCH}" -O "$BIN" --clobber && chmod +x "$BIN" && link_user_bin && exec "$BIN" "$@"
fi
echo "parley: no binary; install Go (https://go.dev) or gh (https://cli.github.com) and retry" >&2
exit 4
